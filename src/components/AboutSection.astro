---
import { Icon } from 'astro-icon/components'
---

<section id="about" class="about-section">
  <div class="about-section__container">
    <h2 class="about-section__title text-center text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-3 sm:mb-4">
      <span class="gradient-text">About Me</span>
    </h2>

    <div class="about-section__grid">
      <figure class="about-section__photo-col">
        <div class="about-section__photo-frame">
          <img
            class="about-section__photo"
            src="/aaryaman-about.jpg"
            alt="Aaryaman Singh in a modern office in Toronto"
            width="3984"
            height="2240"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="about-section__photo-caption">Toronto, ON</figcaption>
      </figure>

      <div class="about-section__content">
        <ul class="about-section__facts" role="list">
          <li class="about-section__fact">
            <Icon name="mdi:map-marker-outline" class="about-section__fact-icon" />
            Toronto, ON
          </li>
          <li class="about-section__fact">
            <Icon name="mdi:school-outline" class="about-section__fact-icon" />
            University of Toronto
          </li>
          <li class="about-section__fact">
            <Icon name="mdi:lightbulb-on-outline" class="about-section__fact-icon" />
            Entrepreneur
          </li>
          <li class="about-section__fact">
            <Icon name="mdi:book-open-page-variant-outline" class="about-section__fact-icon" />
            Published Author
          </li>
        </ul>

        <div class="about-section__panel">
          <p class="about-section__text">
            Fourth year engineering student at the University of Toronto, with minor in Engineering Business. I'm drawn to problems that start out ambiguous and end up structured, and to building things that hold up once real people start using them.
          </p>
          <p class="about-section__text about-section__text--emphasis">
            I've founded a company, published a book, and worked inside a large organization, and the throughline has been the same: clarity beats cleverness.
          </p>
        </div>

        <div class="about-section__links">
          <a
            href="https://www.amazon.ca/dp/1685099394/ref=cm_cr_arp_d_bdcrb_top?ie=UTF8"
            class="about-section__book-btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="mdi:book-open-page-variant-outline" class="about-section__btn-icon" />
            Check out my book
          </a>
          <a
            href="https://www.instagram.com/aaryamanz"
            class="about-section__social-btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="simple-icons:instagram" class="about-section__btn-icon" />
            Instagram
          </a>
          <a
            href="https://www.youtube.com/@AaryamanSingh"
            class="about-section__social-btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="simple-icons:youtube" class="about-section__btn-icon" />
            YouTube
          </a>
          <a
            href="https://x.com/aaryamanz"
            class="about-section__social-btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="simple-icons:x" class="about-section__btn-icon" />
            X
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    margin: 3rem 0;
    padding: 1rem 1rem 2rem;
  }

  @media (min-width: 768px) {
    .about-section {
      margin: 4rem 0;
      padding: 1.5rem 1.5rem 3rem;
    }
  }

  .about-section__container {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .about-section__title {
    margin: 0 0 1.75rem;
  }

  .about-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .about-section__grid {
      grid-template-columns: minmax(240px, 340px) 1fr;
      gap: 2.75rem;
    }
  }

  .about-section__photo-col {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .about-section__photo-frame {
    position: relative;
    width: min(100%, 320px);
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    padding: 3px;
    background: linear-gradient(135deg, #e000b3 0%, #9333ea 45%, #333399 100%);
    box-shadow:
      0 20px 50px rgba(147, 51, 234, 0.22),
      0 8px 24px rgba(15, 23, 42, 0.12);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .about-section__photo-frame::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 17px;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
  }

  .about-section__photo-frame:hover {
    transform: translateY(-4px);
    box-shadow:
      0 28px 60px rgba(147, 51, 234, 0.28),
      0 12px 32px rgba(15, 23, 42, 0.14);
  }

  .about-section__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    border-radius: 17px;
  }

  .about-section__photo-caption {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #64748b;
  }

  :global(.darkmode) .about-section__photo-caption {
    color: rgba(255, 255, 255, 0.55);
  }

  .about-section__content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    text-align: left;
    min-width: 0;
  }

  .about-section__facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .about-section__fact {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #334155;
    border: 1px solid rgba(15, 23, 42, 0.12);
    background: rgba(255, 255, 255, 0.55);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .about-section__fact:hover {
    transform: translateY(-2px);
    border-color: rgba(147, 51, 234, 0.4);
    box-shadow: 0 6px 16px rgba(147, 51, 234, 0.12);
  }

  .about-section__fact-icon {
    width: 15px;
    height: 15px;
    color: #9333ea;
    flex-shrink: 0;
  }

  :global(.darkmode) .about-section__fact {
    color: rgba(255, 255, 255, 0.85);
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
  }

  :global(.darkmode) .about-section__fact:hover {
    border-color: rgba(192, 132, 252, 0.5);
    box-shadow: 0 6px 20px rgba(168, 85, 247, 0.22);
  }

  :global(.darkmode) .about-section__fact-icon {
    color: #c084fc;
  }

  .about-section__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.4rem 1.3rem;
    border-radius: 16px;
    border: 1px solid rgba(148, 163, 184, 0.3);
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(8px);
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .about-section__panel::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, #e000b3 30%, #9333ea 50%, #333399 70%, transparent 100%);
    opacity: 0.7;
  }

  .about-section__panel:hover {
    border-color: rgba(147, 51, 234, 0.35);
    box-shadow: 0 12px 32px rgba(147, 51, 234, 0.1);
  }

  @media (min-width: 768px) {
    .about-section__panel {
      padding: 1.75rem 2rem;
    }
  }

  :global(.darkmode) .about-section__panel {
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
  }

  :global(.darkmode) .about-section__panel:hover {
    border-color: rgba(168, 85, 247, 0.4);
    box-shadow: 0 12px 36px rgba(168, 85, 247, 0.16);
  }

  .about-section__text {
    font-size: 1.02rem;
    line-height: 1.75;
    color: #4b5563;
    margin: 0;
  }

  .about-section__text--emphasis {
    font-weight: 500;
    color: #334155;
  }

  :global(.darkmode) .about-section__text {
    color: rgba(255, 255, 255, 0.75);
  }

  :global(.darkmode) .about-section__text--emphasis {
    color: rgba(255, 255, 255, 0.9);
  }

  .about-section__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .about-section__btn-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .about-section__book-btn,
  .about-section__social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 500;
    color: #7e22ce;
    border: 1px solid rgba(147, 51, 234, 0.35);
    background: rgba(147, 51, 234, 0.08);
    transition: transform 0.2s ease, border-color 0.2s ease, color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .about-section__book-btn:visited,
  .about-section__social-btn:visited {
    color: #7e22ce;
  }

  .about-section__book-btn:hover,
  .about-section__social-btn:hover {
    transform: translateY(-2px);
    color: #6b21a8;
    border-color: rgba(147, 51, 234, 0.55);
    background: rgba(147, 51, 234, 0.16);
    box-shadow: 0 6px 16px rgba(147, 51, 234, 0.16);
  }

  :global(.darkmode) .about-section__book-btn,
  :global(.darkmode) .about-section__social-btn {
    color: #d8b4fe;
    border-color: rgba(192, 132, 252, 0.45);
    background: rgba(88, 28, 135, 0.24);
  }

  :global(.darkmode) .about-section__book-btn:visited,
  :global(.darkmode) .about-section__social-btn:visited {
    color: #d8b4fe;
  }

  :global(.darkmode) .about-section__book-btn:hover,
  :global(.darkmode) .about-section__social-btn:hover {
    color: #f3e8ff;
    border-color: rgba(192, 132, 252, 0.6);
    background: rgba(107, 33, 168, 0.34);
    box-shadow: 0 6px 20px rgba(168, 85, 247, 0.24);
  }

  @media (max-width: 899px) {
    .about-section__content {
      text-align: center;
    }

    .about-section__facts {
      justify-content: center;
    }

    .about-section__links {
      justify-content: center;
    }
  }
</style>
