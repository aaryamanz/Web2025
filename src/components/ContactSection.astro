---
import { Icon } from 'astro-icon/components';
---

<section id="contact" class="contact-section">
  <div class="contact-section__header">
    <h2 class="contact-section__title text-center text-4xl sm:text-5xl md:text-6xl"><span class="gradient-text">Contact</span></h2>
    <p class="contact-section__subtitle">Let's connect for opportunities in capital markets, analytics, and product building.</p>
  </div>

  <article class="contact-shell">
    <div class="contact-shell__intro">
      <p class="contact-shell__eyebrow">Get In Touch</p>
      <h3 class="contact-shell__title">Open to collaborations, internships, and high-impact projects.</h3>
      <p class="contact-shell__text">
        If you're building something at the intersection of engineering, finance, and analytics, I'd love to hear from you.
      </p>
      <div class="contact-shell__quick-actions">
        <a href="mailto:aaryaman.singh@mail.utoronto.ca" class="contact-pill contact-pill--primary">
          <Icon name="mdi:email-fast-outline" />
          Email Me
        </a>
        <a href="https://www.linkedin.com/in/aaryamansingh/" target="_blank" rel="noopener noreferrer" class="contact-pill">
          <Icon name="mdi:linkedin" />
          LinkedIn
        </a>
      </div>
    </div>

    <div class="contact-shell__channels">
      <a href="mailto:aaryaman.singh@mail.utoronto.ca" class="contact-channel">
        <div class="contact-channel__icon">
          <Icon name="mdi:email-outline" />
        </div>
        <div>
          <p class="contact-channel__label">Email</p>
          <p class="contact-channel__value">aaryaman.singh@mail.utoronto.ca</p>
        </div>
      </a>

      <a href="https://www.linkedin.com/in/aaryamansingh/" target="_blank" rel="noopener noreferrer" class="contact-channel">
        <div class="contact-channel__icon">
          <Icon name="mdi:linkedin" />
        </div>
        <div>
          <p class="contact-channel__label">LinkedIn</p>
          <p class="contact-channel__value">/in/aaryamansingh</p>
        </div>
      </a>

      <div class="contact-channel">
        <div class="contact-channel__icon">
          <Icon name="mdi:map-marker-outline" />
        </div>
        <div>
          <p class="contact-channel__label">Location</p>
          <p class="contact-channel__value">Toronto, Ontario</p>
        </div>
      </div>

      <div class="contact-shell__social-row">
        <a href="https://x.com/aaryamanz" target="_blank" rel="noopener noreferrer" aria-label="X profile" class="contact-social">
          <Icon name="simple-icons:x" />
        </a>
        <a href="https://www.instagram.com/aaryamanz" target="_blank" rel="noopener noreferrer" aria-label="Instagram profile" class="contact-social">
          <Icon name="simple-icons:instagram" />
        </a>
        <a href="https://www.youtube.com/@AaryamanSingh" target="_blank" rel="noopener noreferrer" aria-label="YouTube profile" class="contact-social">
          <Icon name="simple-icons:youtube" />
        </a>
      </div>
    </div>
  </article>
</section>

<style>
  .contact-section {
    padding: 1.5rem 0 3.5rem;
  }

  .contact-section__header {
    margin-bottom: 1.5rem;
  }

  .contact-section__title {
    margin: 0 0 0.6rem;
    color: #1f2937;
    font-weight: 700;
  }

  .contact-section__subtitle {
    margin: 0 auto;
    max-width: 50rem;
    text-align: center;
    color: #6b7280;
  }

  .contact-shell {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
    border: 1px solid rgba(15, 23, 42, 0.14);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.8);
    padding: 1.1rem;
    overflow: hidden;
    backdrop-filter: blur(8px);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .contact-shell::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, #e000b3 30%, #9333ea 50%, #333399 70%, transparent 100%);
    opacity: 0.7;
  }

  .contact-shell:hover {
    border-color: rgba(147, 51, 234, 0.32);
    box-shadow: 0 14px 36px rgba(147, 51, 234, 0.1);
  }

  @media (min-width: 980px) {
    .contact-shell {
      grid-template-columns: 1.1fr 1fr;
      align-items: stretch;
      padding: 1.3rem;
    }
  }

  .contact-shell__intro {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    justify-content: center;
    padding: 0.35rem;
  }

  .contact-shell__eyebrow {
    margin: 0;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: linear-gradient(45deg, #e000b3, #333399);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 700;
  }

  .contact-shell__title {
    margin: 0;
    color: #1f2937;
    font-size: 1.32rem;
    line-height: 1.35;
    font-weight: 700;
  }

  .contact-shell__text {
    margin: 0;
    color: #6b7280;
    line-height: 1.65;
  }

  .contact-shell__quick-actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
    margin-top: 0.35rem;
  }

  @media (min-width: 560px) {
    .contact-shell__quick-actions {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-decoration: none;
    font-size: 0.84rem;
    border: 1px solid rgba(15, 23, 42, 0.2);
    color: #334155;
    border-radius: 999px;
    padding: 0.7rem 0.9rem;
    background: rgba(255, 255, 255, 0.88);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .contact-pill:hover {
    transform: translateY(-2px);
    border-color: rgba(147, 51, 234, 0.45);
    box-shadow: 0 6px 18px rgba(147, 51, 234, 0.14);
    color: #6b21a8;
  }

  .contact-pill--primary {
    background: linear-gradient(135deg, #e000b3 0%, #9333ea 55%, #333399 100%);
    color: #ffffff;
    border-color: transparent;
    box-shadow: 0 4px 14px rgba(147, 51, 234, 0.35);
  }

  .contact-pill--primary:hover {
    background: linear-gradient(135deg, #e000b3 0%, #9333ea 55%, #333399 100%);
    border-color: transparent;
    color: #ffffff;
    box-shadow: 0 8px 24px rgba(147, 51, 234, 0.5);
  }

  .contact-shell__channels {
    display: grid;
    gap: 0.7rem;
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 12px;
    padding: 0.8rem;
    background: rgba(248, 250, 252, 0.7);
  }

  .contact-channel {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: center;
    text-decoration: none;
    padding: 0.45rem;
    border-radius: 10px;
    border: 1px solid transparent;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  a.contact-channel:hover {
    background: rgba(147, 51, 234, 0.06);
    border-color: rgba(147, 51, 234, 0.25);
    transform: translateX(4px);
  }

  .contact-channel__icon {
    width: 40px;
    height: 40px;
    border: 1px solid rgba(15, 23, 42, 0.15);
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(15, 23, 42, 0.68);
    transition: color 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }

  a.contact-channel:hover .contact-channel__icon {
    color: #9333ea;
    border-color: rgba(147, 51, 234, 0.4);
    background: rgba(147, 51, 234, 0.08);
  }

  .contact-channel__label {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.74rem;
    color: #6b7280;
    font-weight: 700;
  }

  .contact-channel__value {
    margin: 0.08rem 0 0;
    color: #1f2937;
    font-size: 0.9rem;
  }

  .contact-shell__social-row {
    display: flex;
    gap: 0.55rem;
    padding-top: 0.35rem;
  }

  .contact-social {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(15, 23, 42, 0.2);
    color: #334155;
    background: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    transition: transform 0.2s ease, color 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-social:hover {
    transform: translateY(-3px);
    color: #9333ea;
    border-color: rgba(147, 51, 234, 0.45);
    background: rgba(147, 51, 234, 0.08);
    box-shadow: 0 6px 16px rgba(147, 51, 234, 0.18);
  }

  .contact-social:visited {
    color: #334155;
  }

  :global(.darkmode) .contact-section__title {
    color: #f8fafc;
  }

  :global(.darkmode) .contact-section__subtitle {
    color: rgba(226, 232, 240, 0.7);
  }

  :global(.darkmode) .contact-shell {
    border-color: rgba(148, 163, 184, 0.3);
    background: rgba(2, 6, 23, 0.56);
  }

  :global(.darkmode) .contact-shell__eyebrow {
    background: linear-gradient(45deg, #f472b6, #a5b4fc);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  :global(.darkmode) .contact-shell__title {
    color: #f8fafc;
  }

  :global(.darkmode) .contact-shell__text {
    color: rgba(226, 232, 240, 0.74);
  }

  :global(.darkmode) .contact-pill {
    color: #e2e8f0;
    border-color: rgba(148, 163, 184, 0.4);
    background: rgba(30, 41, 59, 0.58);
  }

  :global(.darkmode) .contact-pill:hover {
    color: #f3e8ff;
    border-color: rgba(192, 132, 252, 0.5);
    box-shadow: 0 6px 20px rgba(168, 85, 247, 0.24);
  }

  :global(.darkmode) .contact-pill--primary {
    color: #ffffff;
    background: linear-gradient(135deg, #e000b3 0%, #9333ea 55%, #333399 100%);
    border-color: transparent;
    box-shadow: 0 4px 16px rgba(168, 85, 247, 0.4);
  }

  :global(.darkmode) .contact-pill--primary:hover {
    background: linear-gradient(135deg, #e000b3 0%, #9333ea 55%, #333399 100%);
    border-color: transparent;
    color: #ffffff;
    box-shadow: 0 8px 26px rgba(168, 85, 247, 0.55);
  }

  :global(.darkmode) .contact-shell:hover {
    border-color: rgba(192, 132, 252, 0.4);
    box-shadow: 0 14px 40px rgba(168, 85, 247, 0.18);
  }

  :global(.darkmode) a.contact-channel:hover {
    background: rgba(168, 85, 247, 0.1);
    border-color: rgba(192, 132, 252, 0.32);
  }

  :global(.darkmode) a.contact-channel:hover .contact-channel__icon {
    color: #d8b4fe;
    border-color: rgba(192, 132, 252, 0.45);
    background: rgba(168, 85, 247, 0.14);
  }

  :global(.darkmode) .contact-social:hover {
    color: #e9d5ff;
    border-color: rgba(192, 132, 252, 0.6);
    background: rgba(168, 85, 247, 0.16);
    box-shadow: 0 6px 20px rgba(168, 85, 247, 0.28);
  }

  :global(.darkmode) .contact-shell__channels {
    border-color: rgba(148, 163, 184, 0.3);
    background: rgba(15, 23, 42, 0.54);
  }

  :global(.darkmode) .contact-channel__icon {
    border-color: rgba(148, 163, 184, 0.3);
    color: rgba(226, 232, 240, 0.84);
  }

  :global(.darkmode) .contact-channel__label {
    color: rgba(226, 232, 240, 0.62);
  }

  :global(.darkmode) .contact-channel__value {
    color: #f8fafc;
  }

  :global(.darkmode) .contact-social {
    border-color: rgba(148, 163, 184, 0.56);
    color: #e2e8f0;
    background: rgba(30, 41, 59, 0.65);
  }

  :global(.darkmode) .contact-social:visited {
    color: #e2e8f0;
  }
</style>
