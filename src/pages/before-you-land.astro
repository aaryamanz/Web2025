<script is:inline>
(function(){
  var KEY = "land-checklist-v1";
  var boxes = Array.prototype.slice.call(document.querySelectorAll(".box"));
  var fill = document.getElementById("fill");
  var doneEl = document.getElementById("done");
  var totalEl = document.getElementById("total");
  var resetBtn = document.getElementById("reset");

  totalEl.textContent = boxes.length;

  boxes.forEach(function(b,i){
    b.id = "item-" + i;
    var h = b.parentElement.querySelector("h3");
    if(h) b.setAttribute("aria-label", h.textContent.replace(/verify$/,"").trim());
  });

  function read(){
    try { return JSON.parse(localStorage.getItem(KEY)) || {}; }
    catch(e){ return {}; }
  }

  function write(state){
    try { localStorage.setItem(KEY, JSON.stringify(state)); }
    catch(e){ /* private browsing: boxes still work, they just won't persist */ }
  }

  function paint(){
    var n = boxes.filter(function(b){ return b.checked; }).length;
    doneEl.textContent = n;
    fill.style.width = (boxes.length ? (n / boxes.length) * 100 : 0) + "%";
  }

  var saved = read();
  boxes.forEach(function(b){ if(saved[b.id]) b.checked = true; });
  paint();

  boxes.forEach(function(b){
    b.addEventListener("change", function(){
      var s = read();
      if(b.checked){ s[b.id] = 1; } else { delete s[b.id]; }
      write(s);
      paint();
    });
  });

  resetBtn.addEventListener("click", function(){
    boxes.forEach(function(b){ b.checked = false; });
    write({});
    paint();
  });
})();
</script>

