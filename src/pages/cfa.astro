<script is:inline>
  (function () {
    if (window.__cfaPageInitialized) return;
    window.__cfaPageInitialized = true;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const UNLOCK_KEY = 'cfaPremiumUnlocked';

    function animateCounters() {
      const stats = document.querySelectorAll('.cfa-stat');
      if (!stats.length) return;

      const io = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            const el = entry.target;
            observer.unobserve(el);

            const target = Number(el.getAttribute('data-target') || 0);
            const numberEl = el.querySelector('.cfa-stat__number');
            if (!numberEl || !target || Number.isNaN(target)) return;

            if (prefersReducedMotion.matches) {
              numberEl.textContent = String(target);
              return;
            }

            let current = 0;
            const duration = 1200;
            const start = performance.now();

            const step = (ts) => {
              const t = Math.min(1, (ts - start) / duration);
              const eased = 1 - Math.pow(1 - t, 3);
              current = Math.floor(target * eased);
              numberEl.textContent = String(current);
              if (t < 1) requestAnimationFrame(step);
            };

            requestAnimationFrame(step);
          });
        },
        { threshold: 0.2 }
      );

      stats.forEach((stat) => io.observe(stat));
    }

    function initTimelineTabs() {
      const tabs = document.querySelectorAll('.cfa-timeline__tab');
      const phases = document.querySelectorAll('.cfa-phase');
      if (!tabs.length || !phases.length) return;

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const phaseId = tab.getAttribute('data-phase');
          tabs.forEach((t) => t.classList.remove('is-active'));
          tab.classList.add('is-active');
          phases.forEach((pane) => {
            pane.classList.toggle('is-active', pane.getAttribute('data-phase') === phaseId);
          });
        });
      });
    }

    function initTopics() {
      const topics = document.querySelectorAll('.cfa-topic');
      if (!topics.length) return;

      topics.forEach((topic) => {
        const header = topic.querySelector('.cfa-topic__header');
        if (!header) return;

        header.addEventListener('click', () => {
          const isOpen = topic.classList.contains('is-open');
          topics.forEach((t) => t.classList.remove('is-open'));
          if (!isOpen) topic.classList.add('is-open');
        });
      });
    }

    function initWeeks() {
      const weeks = document.querySelectorAll('.cfa-week');
      if (!weeks.length) return;

      weeks.forEach((week) => {
        const header = week.querySelector('.cfa-week__header');
        if (!header) return;

        header.addEventListener('click', () => {
          const isOpen = week.classList.contains('is-open');
          weeks.forEach((w) => w.classList.remove('is-open'));
          if (!isOpen) week.classList.add('is-open');
        });
      });
    }

    function colorMockTable() {
      const cells = document.querySelectorAll('.cfa-mocks__table td[data-score]');
      cells.forEach((cell) => {
        const score = Number(cell.getAttribute('data-score') || 0);
        if (score >= 70) {
          cell.classList.add('score-good');
        } else if (score >= 60) {
          cell.classList.add('score-mid');
        } else {
          cell.classList.add('score-low');
        }
      });
    }

    function showPremium() {
      const premium = document.getElementById('premium-content');
      const gate = document.getElementById('paywall-gate');
      const error = document.getElementById('cfa-key-error');
      if (premium) premium.style.display = '';
      if (gate) gate.style.display = 'none';
      if (error) error.textContent = '';
    }

    async function verifyKey(key) {
      const res = await fetch('/api/verify-key', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key })
      });

      if (!res.ok) return { valid: false };
      return res.json();
    }

    function initUnlock() {
      const input = document.getElementById('cfa-key-input');
      const button = document.getElementById('cfa-key-submit');
      const error = document.getElementById('cfa-key-error');
      const premium = document.getElementById('premium-content');
      const gate = document.getElementById('paywall-gate');
      if (!input || !button || !error || !premium || !gate) return;

      const unlocked = sessionStorage.getItem(UNLOCK_KEY) === 'true';
      if (unlocked) {
        showPremium();
        return;
      }

      const attemptUnlock = async () => {
        const key = (input.value || '').trim();
        if (!key) {
          error.textContent = 'Please enter your access key.';
          return;
        }

        error.textContent = 'Verifying key...';
        button.disabled = true;

        try {
          const result = await verifyKey(key);
          if (result && result.valid) {
            sessionStorage.setItem(UNLOCK_KEY, 'true');
            showPremium();
          } else {
            error.textContent = 'Invalid access key. Please check your purchase email.';
          }
        } catch {
          error.textContent = 'Unable to verify key right now. Please try again shortly.';
        } finally {
          button.disabled = false;
        }
      };

      if (!button.dataset.bound) {
        button.addEventListener('click', attemptUnlock);
        input.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') {
            event.preventDefault();
            attemptUnlock();
          }
        });
        button.dataset.bound = 'true';
      }
    }

    function initPage() {
      animateCounters();
      initTimelineTabs();
      initTopics();
      initWeeks();
      colorMockTable();
      initUnlock();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPage);
    } else {
      initPage();
    }

    document.addEventListener('astro:page-load', initPage);
  })();
</script>

